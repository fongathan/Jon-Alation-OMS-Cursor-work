# ─── Alation Analytics v2 PostgreSQL connection ───────────────────────────────
# Copy this file to .env and fill in your values.
# The Analytics DB credentials are in Alation Admin > Alation Analytics.

ALATION_ANALYTICS_HOST=disney-data.alationcloud.com
ALATION_ANALYTICS_PORT=5432
ALATION_ANALYTICS_DB=alation_analytics
ALATION_ANALYTICS_USER=jonathan.fong@disney.com
ALATION_ANALYTICS_PASSWORD=TomTerrie26AriaClark!

# ─── Dashboard period ─────────────────────────────────────────────────────────
# How many days back to compute metrics. 90 = last quarter.
PERIOD_DAYS=90

# ─── Alation REST API (for refresh_from_alation.py) ────────────────────────────
ALATION_BASE_URL=https://disney-data.alationcloud.com
ALATION_REFRESH_TOKEN=PASTE_YOUR_REFRESH_TOKEN_HERE
ALATION_USER_ID=PASTE_YOUR_USER_ID_HERE

# Query IDs (from Compose URLs)
ALATION_QUERY_01_SUMMARY=2026
ALATION_QUERY_02_TOP_USERS=2027
ALATION_QUERY_03_CURATION=2028
ALATION_QUERY_04_DAU_MAU=2029
ALATION_QUERY_05_SEARCHES=2030
ALATION_QUERY_06_VISITED=2031
ALATION_QUERY_07_GOVERNANCE=2032
ALATION_QUERY_08_SEARCH_DAILY=2033
