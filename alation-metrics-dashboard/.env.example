# ─── Alation REST API (for refresh_from_alation.py + cron) ─────────────────────
# Copy this file to .env and fill in your values.

# Your Alation instance URL (no trailing slash)
ALATION_BASE_URL=https://disney-data.alationcloud.com

# Option A: Refresh token (recommended for cron — long-lived, script gets access token each run)
# Create in Alation: Account Settings → Authentication → Create Refresh Token
ALATION_REFRESH_TOKEN=your_refresh_token_here
ALATION_USER_ID=123

# Option B: API access token (short-lived, ~24h — use for testing only)
# ALATION_API_TOKEN=your_access_token_here

# ─── Query IDs (fill in after Step 2) ──────────────────────────────────────────
# Get these from the URL when you open each saved query in Compose:
#   /compose/query/123/  →  ALATION_QUERY_01_SUMMARY=123
ALATION_QUERY_01_SUMMARY=0
ALATION_QUERY_02_TOP_USERS=0
ALATION_QUERY_03_CURATION=0
ALATION_QUERY_04_DAU_MAU=0
ALATION_QUERY_05_SEARCHES=0
ALATION_QUERY_06_VISITED=0
ALATION_QUERY_07_GOVERNANCE=0
ALATION_QUERY_08_SEARCH_DAILY=0

# ─── (Legacy) Direct PostgreSQL — only if using export.py instead ─────────────
# ALATION_ANALYTICS_HOST=localhost
# ALATION_ANALYTICS_PORT=5432
# ALATION_ANALYTICS_DB=alation_analytics
# ALATION_ANALYTICS_USER=alation_analytics
# ALATION_ANALYTICS_PASSWORD=
